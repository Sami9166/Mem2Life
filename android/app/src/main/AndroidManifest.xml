<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vuzix Blade 2 온보드 카메라(Camera2) / 마이크(AudioRecord) 직접 캡처.
         앱이 글래스 위에서 단독 실행되므로 원격 스트림용 Bluetooth 권한은 필요 없다. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 세션 녹화 중 포그라운드 서비스로 카메라 캡처/청크 업로드/오디오 스트리밍 유지.
         FOREGROUND_SERVICE_CAMERA/MICROPHONE은 API 34+에서 타입별로 요구된다
         (Blade 2 자체는 API 30이지만 에뮬레이터/미래 기기 호환을 위해 선언). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Blade 2에는 카메라/마이크가 모두 있다. required=false는 에뮬레이터 등
         개발 환경 설치를 막지 않기 위한 것. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Blade 2 디스플레이는 480x480 논터치 — 터치패드(트랙볼/D-pad 이벤트)로
         조작한다. touchscreen 미요구 선언이 없으면 설치가 거부될 수 있다. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".Mem2LifeApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_mem2life"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mem2LifeCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Mem2LifeCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

    </application>
</manifest>
