RTZR_CLIENT_ID=your-rtzr-client-id
RTZR_CLIENT_SECRET=your-rtzr-client-secret
MEM2LIFE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mem2life

# VLM 캡션 + LLM 요약 + fallback 영상 재조회 (기술조사_의사결정.md 조사4 —
# 셋 다 Gemini로 통일). Google AI Studio(https://aistudio.google.com/apikey)에서
# 발급. 비워두면 각 factory.py가 자동으로 플레이스홀더/스텁으로 폴백한다.
GEMINI_API_KEY=your-gemini-api-key
# 선택: 기본값(gemini-2.5-flash) 대신 다른 Gemini 모델을 쓰고 싶을 때만 설정.
# GEMINI_MODEL=gemini-2.5-flash
