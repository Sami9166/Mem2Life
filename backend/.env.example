RTZR_CLIENT_ID=your-rtzr-client-id
RTZR_CLIENT_SECRET=your-rtzr-client-secret
MEM2LIFE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mem2life

# STT provider 선택: rtzr | gemini | soniox | clova. 미설정 시 rtzr.
#   - rtzr  : 리턴제로(음향 기반 화자분리). 정밀 타임스탬프. 과분할 경향(→ SPEAKER_MERGE로 교정).
#   - gemini: 오디오를 Gemini에 보내 전사+화자+타임스탬프(GEMINI_API_KEY 필요). 실측상
#             RTZR보다 깔끔하나, 애매한 구간을 문맥으로 보정(환각)하는 경향. 키 없으면 스텁 폴백.
#   - soniox: 전용 STT 서비스. 단어 단위 타임스탬프 + 화자분리, 다국어. SONIOX_API_KEY 필요.
#             키 없으면 스텁 폴백.
#   ※ 자동 파이프라인(글래스 녹화종료 → 글루)은 --stt를 안 주므로 이 값이 토글점이다.
#     수동 실행은 `--stt soniox`로 세션별 override 가능.
# STT_PROVIDER=rtzr

# Soniox 전사 설정 (STT_PROVIDER=soniox일 때). https://console.soniox.com 에서 키 발급.
# SONIOX_API_KEY=your-soniox-api-key
# SONIOX_MODEL=stt-async-v5                 # 선택: 기본 stt-async-v5
# SONIOX_LANGUAGE_HINTS=ko,en               # 선택: 콤마 구분 언어 힌트(기본 ko,en)

# 화자 수 고정. 0 또는 미설정 = 자동 추정(불안정, 한 명을 여러 명으로 과분할하는 경향).
# 화자 수를 알면(예: 2인 대화) 명시하면 안정된다. rtzr·gemini provider 모두 이 값을 힌트로 쓴다.
# RTZR_SPK_COUNT=2

# LLM 내용 기반 화자 병합 후처리 on/off. 기본 on(GEMINI_API_KEY 있을 때만 실제 동작,
# 없으면 자동으로 무변경). off로 두면 음향 화자분리 결과를 그대로 쓴다.
# (수동 실행은 --no-speaker-merge 플래그로도 끌 수 있다.)
# SPEAKER_MERGE=on

# VLM 캡션 + LLM 요약 + 768차원 검색 임베딩 + fallback 영상 재조회.
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한다. 비워두면
# 캡션/요약/재조회는 스텁으로 폴백하지만 기본 검색 임베딩은 명확한 오류를 낸다.
# API 키 없이 검색 구조만 시험하려면 CLI에 --embedding hash를 명시한다.
GEMINI_API_KEY="your-gemini-api-key"

# 선택: 기본값(gemini-2.5-flash) 대신 다른 Gemini 모델을 쓰고 싶을 때만 설정.
# GEMINI_MODEL=gemini-2.5-flash